<%- include("../partials/header", { title }) %>
<%- include("../partials/navbar") %>
<main class="container py-5 form-container">
  <a href="/category" class="text-decoration-none">← Back to categories</a>
  <div class="form-card mt-3">
    <h1 class="h3 fw-bold"><%= title %></h1>
    <p class="text-secondary">Enter the category information below.</p>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <form action="<%= formAction %>" method="POST">
      <div class="mb-3"><label class="form-label">Category Name</label><input class="form-control" type="text" name="name" value="<%= category.name || '' %>" placeholder="e.g. Technology" required minlength="3"></div>
      <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4" placeholder="Describe this category..." required minlength="3"><%= category.description || '' %></textarea></div>
      <div class="mb-4"><label class="form-label">Image URL</label><input class="form-control" type="url" name="imageurl" value="<%= category.imageurl || '' %>" placeholder="https://example.com/image.jpg" required></div>
      <div class="d-flex gap-2"><button class="btn btn-primary"><%= submitLabel %></button><a href="/category" class="btn btn-light">Cancel</a></div>
    </form>
  </div>
</main>
<%- include("../partials/footer") %>
